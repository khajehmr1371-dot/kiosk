@@ -0,0 +1,42 @@
+package ir.bastiyan.kiosk.display;
+
+import java.net.URI;
+import java.util.Locale;
+
+/** Pure-Java safe URL resolution for the two official PHP Kiosk API entrypoints. */
+public final class EndpointResolver {
+    private EndpointResolver() {}
+    public static String normalizeBase(String raw) {
+        try {
+            URI u=new URI(raw==null?"":raw.trim());
+            if(!"https".equalsIgnoreCase(u.getScheme())||u.getHost()==null||
+               u.getRawUserInfo()!=null||u.getRawFragment()!=null||
+               (u.getPort()!=-1 && u.getPort()!=443))throw new IllegalArgumentException();
+            String path=u.getRawPath()==null?"":u.getRawPath();
+            if(path.contains("%")||path.contains("\\")||path.contains("//")||
+               path.contains("/../")||path.endsWith("/..")||path.contains("/./")||
+               !path.matches("[a-zA-Z0-9_./-]*"))throw new IllegalArgumentException();
+            String query=u.getRawQuery();
+            if(query!=null && !(path.endsWith("/api.php") && query.matches("route=(?:health|state)")))
+                throw new IllegalArgumentException();
+            path=path.replaceFirst("/+(?:api/(?:health|state)|api(?:/)?|api\\.php|login(?:\\.html)?|tv(?:\\.html)?|admin|android-tv(?:\\.html)?|display-install)(?:/)?$","");
+            while(path.endsWith("/"))path=path.substring(0,path.length()-1);
+            String host=u.getHost().toLowerCase(Locale.ROOT);
+            if(host.indexOf(':')>=0)host="["+host+"]";
+            return "https://"+host+path;
+        }catch(Exception e) {
+            throw new IllegalArgumentException("نشانی سرور نامعتبر است. آدرس HTTPS سامانه، مانند https://example.ir، را وارد کنید (بدون رمز یا پارامتر)");
+        }
+    }
+    public static String endpoint(String base,boolean directPhp,String route) {
+        if(route==null||!route.matches("[a-zA-Z0-9/_-]+(?:\\?[a-zA-Z0-9_=&-]+)?"))
+            throw new IllegalArgumentException("مسیر API معتبر نیست");
+        return directPhp ? base+"/api.php?route="+route.replace('?', '&') : base+"/api/"+route;
+    }
+    public static String media(String base,boolean directPhp,String path) {
+        if(path==null || !path.matches("/api/media/file\\?centerId=[a-zA-Z0-9_%.-]+&mediaId=[a-zA-Z0-9_-]+"))
+            throw new IllegalArgumentException("نشانی رسانه مجاز نیست");
+        if(!directPhp)return base+path;
+        return base+"/api.php?route=media/file&"+path.substring(path.indexOf('?')+1);
+    }
+}
